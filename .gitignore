# Media files
backend/media/
backend/staticfiles/
backend/static_root/

# Environment variables
backend/.env
backend/.env.local
backend/.env.*.local
backend/.env.production
backend/.env.development

# Django secret key
backend/secret_key.txt
backend/.secret

