*.egg
MANIFEST

# Django
*.log
*.pot
*.pyc
*.pyo
*.db
backend/db.sqlite3
backend/db.sqlite3-journal
backend/*.sqlite3

# Django migrations (manter estrutura, ignorar arquivos gerados)
