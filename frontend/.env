# API Base URL
# Para desenvolvimento local:
VITE_API_URL=http://localhost:8000/api

# Para ngrok (substitua pela URL do seu ngrok do backend):
# VITE_API_URL=https://xxxx-xxxx-xxxx.ngrok-free.dev/api

# WebSocket URL
# Para desenvolvimento local:
VITE_WS_URL=ws://localhost:8000

# Para ngrok (substitua pela URL do seu ngrok do backend):
# IMPORTANTE: Use a mesma URL do backend, mas com wss:// para HTTPS
# VITE_WS_URL=wss://xxxx-xxxx-xxxx.ngrok-free.dev
# OU simplesmente (o código detecta automaticamente):
# VITE_WS_URL=https://xxxx-xxxx-xxxx.ngrok-free.dev

